<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bot driver is Lua and runs under MoonSharp in ik-fiesta-bots; the simulator hosts the same
         interpreter so the SAME script can be run against simulated mobs instead of a live server. -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
</Project>
