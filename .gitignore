# ---- BYO: never commit game binaries or data -------------------------------------------------------
# The emulator is built FROM Zone.exe/Zone.pdb but must never carry them. Operators supply them locally.
*.exe
*.pdb
*.dll
!**/bin/**/Fiesta.Emu.*.dll
Zone*/
9Data/
ressystem/
*.shn
*.pcap
*.pcapng

# ---- build -----------------------------------------------------------------------------------------
bin/
obj/
*.user

# ---- local scratch ---------------------------------------------------------------------------------
CLAUDE.md
tickets.md
.venv/
__pycache__/
*.pyc
_scratch/

# Server state snapshots from tools/capture_state.py. BYO, like the captures they pair with: they carry a
# live character's gear and stats, and they are only meaningful next to their own pcap. Keep them beside
# the capture, not in git.
state-*.json
